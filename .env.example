# Windows LLVM-MinGW x64. Load .env in the parent process before CMake.
# Use absolute paths with forward slashes to the matching SDK installations.
VCPKG_CACHE_REPOSITORY_ROOT=C:/src/vcpkg-cache-v0.1.8
VCPKG_CACHE_VERSION=0.1.8
VCPKG_INSTALLED_DIR=C:/sdk/vcpkg-cache-0.1.8-windows-x64/payload/vcpkg_installed
SALTS_BASE_VERSION=0.1.10
SALTS_BASE_ROOT=C:/sdk/salts-base-0.1.10-windows-llvm-mingw-x64
CMETA_VERSION=0.1.10
CMETA_REF=5f4e0444fbbe1bc51b8e892b36c2708933f39d90
CMETA_ROOT=C:/sdk/cmeta-0.1.10-windows-llvm-mingw-x64
# The CNet SDK must export the legacy SNMPv3 crypto capability.
SALTS_CNET_VERSION=0.1.18
SALTS_CNET_REF=91011fa6a4a4836af97dc569a91dce55a82ff443
SALTS_CNET_ROOT=C:/sdk/salts-cnet-0.1.18-snmp-windows-llvm-mingw-x64
SALTS_UTILS_VERSION=0.1.8
SALTS_UTILS_ROOT=C:/sdk/salts-utils-0.1.8-windows-llvm-mingw-x64
LLVM_MINGW_ROOT=C:/tools/llvm-mingw
RE2C_ROOT=C:/sdk/re2c/tools/windows-x64
