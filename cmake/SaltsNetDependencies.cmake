function(saltsnet_require_sdk package minimum_version root_variable)
  file(TO_CMAKE_PATH "$ENV{${root_variable}}" sdk_root)
  if(NOT IS_DIRECTORY "${sdk_root}")
    message(FATAL_ERROR "${root_variable} must name the installed ${package} SDK")
  endif()
  unset(${package}_DIR CACHE)
  unset(${package}_DIR)
  find_package(${package} ${minimum_version} CONFIG REQUIRED PATHS "${sdk_root}"
               NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)
  if(package STREQUAL "SaltsCNet" AND NOT SaltsCNet_LEGACY_SNMP_CRYPTO)
    message(FATAL_ERROR "SALTS_CNET_ROOT must provide the SNMPv3 legacy crypto APIs")
  endif()
endfunction()

find_package(Threads REQUIRED)
saltsnet_require_sdk(SaltsBase 0.1.10 SALTS_BASE_ROOT)
saltsnet_require_sdk(CMeta 0.1.10 CMETA_ROOT)
saltsnet_require_sdk(SaltsCNet 0.1.18 SALTS_CNET_ROOT)
saltsnet_require_sdk(SaltsUtils 0.1.8 SALTS_UTILS_ROOT)
